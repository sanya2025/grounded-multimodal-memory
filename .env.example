# Copy to .env and fill in as needed. Never commit the real .env.
# Library code reads these via os.environ; do NOT hard-code secrets in source.

# Hugging Face access token (only needed for gated models).
HF_TOKEN=

# Where to cache downloaded model weights (keep OUT of the git tree).
HF_HOME=./hf_cache
TRANSFORMERS_CACHE=./hf_cache

# Dataset roots (see configs/datasets.yaml). Absolute or relative paths.
GQA_ROOT=./data/raw/gqa
VISUAL_GENOME_ROOT=./data/raw/visual_genome
CLEVR_ROOT=./data/raw/clevr
COCO_ROOT=./data/raw/coco

# Default compute device for adapters: "cuda", "mps", or "cpu".
GMM_DEVICE=cpu

# API service.
GMM_API_HOST=127.0.0.1
GMM_API_PORT=8000
